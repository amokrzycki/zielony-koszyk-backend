NODE_ENV=development
PORT=3000
MAILGUN_API_KEY=mailgun_api_key
MAILGUN_DOMAIN=domain.com
MAILGUN_HOST=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=postmaster@domain.com
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgresql://user:password@host:5432/database
MFA_OTP_HMAC_KEY=replace_with_output_of_openssl_rand_base64_32
MFA_TOTP_ENCRYPTION_KEY=replace_with_another_output_of_openssl_rand_base64_32
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave both empty for Mailpit; set both for authenticated SMTP.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=postmaster@domain.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Zielony Koszyk
WEBAUTHN_ORIGIN=http://localhost:5173
RESEARCH_MAIL_DOMAIN=example.test
# Set MFA_RESEARCH_PASSWORD only in .env or process environment.
MFA_RESEARCH_PASSWORD=
RESEARCH_BACKEND_URL=http://localhost:3000
RESEARCH_FRONTEND_URL=http://localhost:5173
RESEARCH_CHROMIUM_PATH=/usr/bin/chromium
